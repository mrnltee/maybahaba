# MayBahaBa — environment variables
#
# Copy this file to `.env.local` for local development. Nothing here is
# required to run the app — with no Supabase variables set, MayBahaBa
# runs on an in-memory mock data provider seeded with clearly-labeled
# DEMO DATA, so you can evaluate the whole product with zero setup.
#
# THREE PLACES THESE LIVE, depending on how you're running:
#   `next dev`                  → .env.local        (this file's format)
#   `npm run preview` (workerd) → .dev.vars         (see .dev.vars.example)
#   deployed Worker             → `wrangler secret put NAME`
# They are NOT shared. Keep them in sync. See README → Deployment.
#
# See README.md → "Environment variables" for details on each one,
# including which services are free and which could incur cost.

# ---------------------------------------------------------------------
# Database — Supabase (PostgreSQL + PostGIS)
# FREE TIER: yes, generous free tier. Sign up at https://supabase.com
# Leave unset to run on local mock data instead.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. Supabase's Connect panel calls this the PUBLISHABLE
# key (sb_publishable_...). Older projects have an "anon" JWT instead —
# either variable name works, use whichever your dashboard shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=     # legacy alternative

# Server-only, bypasses row-level security. Called the SECRET key
# (sb_secret_...) in newer projects, service_role in older ones.
# Required for /admin moderation actions.
# NEVER expose this to the browser or commit it.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=         # legacy alternative

# ---------------------------------------------------------------------
# Maps & geocoding
# FREE / OPEN SOURCE: OpenStreetMap tiles + Nominatim geocoding are used
# by default and require NO API key and NO env vars. See README →
# "Map & geocoding" before considering a paid provider.
# ---------------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER=osm

# ---------------------------------------------------------------------
# Abuse prevention
# ---------------------------------------------------------------------
# Salt used to hash client identifiers (IP addresses) for rate limiting.
# Set this to a long random string in production; raw IPs are never
# stored regardless of this value.
ABUSE_HASH_SALT=

# ---------------------------------------------------------------------
# Moderation
# ---------------------------------------------------------------------
# Shared passcode that gates /admin/validate. This is a lightweight MVP
# protection, not full auth — see README → "Roadmap" for the upgrade
# path to per-moderator accounts.
ADMIN_PASSCODE=
